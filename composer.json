{
  "name": "ml2c/vault",
  "description": "Coffre-fort de mots de passe Symfony, chiffrement dans le navigateur",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2",
    "ext-json": "*",
    "ext-openssl": "*",
    "symfony/asset": "^7.4",
    "symfony/console": "^7.4",
    "symfony/dotenv": "^7.4",
    "symfony/framework-bundle": "^7.4",
    "symfony/flex": "^2.8",
    "symfony/rate-limiter": "^7.4",
    "symfony/runtime": "^7.4",
    "symfony/security-bundle": "^7.4",
    "symfony/security-csrf": "^7.4",
    "symfony/twig-bundle": "^7.4",
    "symfony/yaml": "^7.4",
    "symfony/uid": "^7.4",
    "doctrine/dbal": "^3.9 || ^4.0",
    "doctrine/doctrine-bundle": "^2.18 || ^3.0",
    "doctrine/doctrine-migrations-bundle": "^3.4",
    "doctrine/orm": "^3.3",
    "doctrine/migrations": "^3.8",
    "twig/twig": "^3.12",
    "symfony/mailer": "^7.4",
    "symfony/brevo-mailer": "^7.4",
    "symfony/http-client": "^7.4"
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd"
    },
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ]
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "7.4.*"
    }
  },
  "require-dev": {
    "doctrine/doctrine-fixtures-bundle": "^4.3"
  }
}
